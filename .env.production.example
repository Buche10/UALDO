# Configuracion de produccion para la PWA de Ualdo
# Todas las URLs en produccion deben usar HTTPS obligatorio.

# URL base del motor central (UaldoBusiness API)
VITE_API_BASE_URL=https://api.ualdo.ejemplo.com/api/v1

# URL base del backend de Ualdo Teams (gestion de tareas)
VITE_TEAMS_API_URL=https://teams.ualdo.ejemplo.com/api
